+//! Training-only escalation of a necessary rank event. Small selected subsets
+//! share internal fixtures; their marginal probabilities are never multiplied
+//! as if those shared fixtures were independent.
+use super::*;
+
+fn table(
+    games: Vec<RankGame>,
+    t: usize,
+    base: i32,
+    target: i32,
+    above: bool,
+    padding: i32,
+) -> TerminalTable {
+    let span: i32 = padding
+        + games
+            .iter()
+            .map(|g| {
+                *if g.home == t { &g.hg } else { &g.ag }
+                    .iter()
+                    .max()
+                    .unwrap()
+            })
+            .sum::<i32>();
+    TerminalTable::new(
+        games,
+        t,
+        (0..=span)
+            .map(|a| {
+                if if above {
+                    base + a <= target
+                } else {
+                    base + a >= target
+                } {
+                    1.
+                } else {
+                    0.
+                }
+            })
+            .collect(),
+    )
+}
+
+/// Exact probability of at most `allowed` strict exceptions in `selected`,
+/// conditional on a fixed target path. Ties are retained in the necessary event.
+fn screen(
+    games: &[RankGame],
+    points: &[i32],
+    target: i32,
+    selected: &[usize],
+    above: bool,
+    allowed: usize,
+) -> Option<(f64, usize)> {
+    let internal: Vec<_> = games
+        .iter()
+        .copied()
+        .filter(|g| selected.contains(&g.home) && selected.contains(&g.away))
+        .collect();
+    let states = 3usize.checked_pow(internal.len() as u32)?;
+    if states > 12000 {
+        return None;
+    }
+    let tables: Vec<_> = selected
+        .iter()
+        .map(|&t| {
+            table(
+                games
+                    .iter()
+                    .copied()
+                    .filter(|g| {
+                        (g.home == t || g.away == t) && !internal.iter().any(|v| v.index == g.index)
+                    })
+                    .collect(),
+                t,
+                points[t],
+                target,
+                above,
+                internal
+                    .iter()
+                    .filter(|g| g.home == t || g.away == t)
+                    .map(|g| {
+                        *if g.home == t { &g.hg } else { &g.ag }
+                            .iter()
+                            .max()
+                            .unwrap()
+                    })
+                    .sum(),
+            )
+        })
+        .collect();
+    let mut mass = 0.;
+    for mut code in 0..states {
+        let mut added = vec![0; selected.len()];
+        let mut weight = 1.;
+        for g in &internal {
+            let o = code % 3;
+            code /= 3;
+            weight *= g.prob[o];
+            added[selected.iter().position(|&t| t == g.home).unwrap()] += g.hg[o];
+            added[selected.iter().position(|&t| t == g.away).unwrap()] += g.ag[o];
+        }
+        let mut dp = vec![0.; allowed + 1];
+        dp[0] = 1.;
+        for (tab, gain) in tables.iter().zip(added) {
+            let safe = tab.mass(gain as usize).clamp(0., 1.);
+            for k in (0..=allowed).rev() {
+                dp[k] = dp[k] * safe + if k > 0 { dp[k - 1] * (1. - safe) } else { 0. };
+            }
+        }
+        mass += weight * dp.iter().sum::<f64>();
+    }
+    Some((mass, states))
+}
+
+impl LazyJoint {
+    fn residual_cases(&mut self, m: &Model, width: usize) -> serde_json::Value {
+        self.cases.clear();
+        self.node_limit = self.nodes + 20000;
+        let old = self.subset;
+        self.subset = false;
+        let keys: Vec<_> = self
+            .mixture
+            .iter()
+            .map(|(k, _)| k.clone())
+            .take(2)
+            .collect();
+        let mut diagnostics = Vec::new();
+        for key in keys {
+            let mut points = self.base.clone();
+            for (g, &o) in self.target.games.iter().zip(&key) {
+                points[g.home] += g.hg[o as usize];
+                points[g.away] += g.ag[o as usize];
+            }
+            let target = points[self.cell.team];
+            let rivals: Vec<_> = (0..m.n).filter(|&t| t != self.cell.team).collect();
+            let d = Domains::propagate(&self.remaining, &points, &rivals, self.cell.rank, target);
+            if !d.feasible {
+                continue;
+            }
+            let fixed_above = rivals
+                .iter()
+                .filter(|&&t| points[t] + d.min[0][t] > target)
+                .count();
+            let fixed_below = rivals
+                .iter()
+                .filter(|&&t| points[t] + d.max[0][t] < target)
+                .count();
+            let above = self.cell.rank.saturating_sub(fixed_above)
+                <= (m.n - 1 - self.cell.rank).saturating_sub(fixed_below);
+            let allowed = if above {
+                self.cell.rank - fixed_above
+            } else {
+                m.n - 1 - self.cell.rank - fixed_below
+            };
+            let mut candidates: Vec<_> = rivals
+                .iter()
+                .copied()
+                .filter(|&t| points[t] + d.min[0][t] <= target && points[t] + d.max[0][t] >= target)
+                .map(|t| {
+                    let p = table(
+                        self.remaining
+                            .iter()
+                            .copied()
+                            .filter(|g| g.home == t || g.away == t)
+                            .collect(),
+                        t,
+                        points[t],
+                        target,
+                        above,
+                        0,
+                    )
+                    .mass(0);
+                    (t, p)
+                })
+                .collect();
+            candidates.sort_by(|a, b| a.1.total_cmp(&b.1).then(a.0.cmp(&b.0)));
+            let selected: Vec<_> = candidates.iter().take(width).map(|&(t, _)| t).collect();
+            if selected.len() <= allowed || selected.len() > 31 {
+                continue;
+            }
+            let mut screened: Vec<_> = selected.iter().copied().take(6).collect();
+            let measured = loop {
+                if screened.len() <= allowed {
+                    break None;
+                }
+                if let Some(v) = screen(&self.remaining, &points, target, &screened, above, allowed)
+                {
+                    break Some(v);
+                }
+                screened.pop();
+            };
+            let Some((bound, states)) = measured else {
+                continue;
+            };
+            // This is a P-event screen, not a bound on the guided proposal's
+            // hit rate. Escalation also requires independently weak pilot ESS.
+            if bound * 30000. >= 1. {
+                continue;
+            }
+            let selected_mask = selected.iter().fold(0u32, |s, &t| s | (1 << t));
+            let mut cases = Cases {
+                above,
+                selected: selected_mask,
+                patterns: Vec::new(),
+                mass: 0.,
+                complete: true,
+            };
+            fn enumerate(ts: &[usize], i: usize, left: usize, mask: u32, out: &mut Vec<u32>) {
+                if out.len() >= 33 {
+                    return;
+                }
+                if i == ts.len() {
+                    out.push(mask);
+                    return;
+                }
+                enumerate(ts, i + 1, left, mask, out);
+                if left > 0 {
