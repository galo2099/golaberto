+        })).unwrap();
+        let model = Model::new(request).unwrap();
+        let p = Problem::new(&model).unwrap().negated();
+        for floor in -3..=15 {
+            for exempt in 0..32_u64 {
+                let mut expected = false;
+                for subset in 1..32_u64 {
+                    if subset & exempt != 0 {
