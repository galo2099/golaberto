<% @current_phase ||= @championship.phases[-1] %>
<%= link_to _("Table"), :action => :phases, :id => @championship,
                     :phase => @current_phase %><br/>
<%= link_to _("Games"), :action => :games, :id => @championship,
                     :phase => @current_phase %><br/>
<%= link_to _("Teams"), :action => :team, :id => @championship %><br/>
<%= link_to _("Crowd"), :action => :crowd, :id => @championship %><br/>
<%= link_to _("Players"), :action => :player_list, :id => @championship %><br/>

<% if can? :manage, @championship %>
  <br/>
  <% backfill_start_message = _("Starting odds history backfill...") %>
  <% backfill_error_message = _("Cant start odds history backfill") %>
<script type="text/javascript">
 function start_backfill_odds_history() {
  <%= remote_function(
          :url => { :controller => :group,
                    :action => :start_odds_history_backfill,
                    :id => @championship },
          :failure => "alert('#{backfill_error_message}')",
          :before => "$('#backfill_odds_history_status').html('#{backfill_start_message}')") %>
}
</script>

 <%= link_to _("Edit championship"), :action => "edit", :id => @championship %><br/>
  <%= link_to _("New game"), :action => :new_game, :id => @championship,
	  :phase => @current_phase %><br/>
  <a href="javascript:start_backfill_odds_history()"><%= _("Backfill odds history") %></a><br/>
<% if @current_phase && defined?(@hide_odds) && !@hide_odds %>
  <span id="phase_recalculate<%= @current_phase.id %>" data-authorize="group">
    <a href="javascript:recalculate_phase_odds(<%= @current_phase.id %>, <%= @current_phase.groups.pluck(:id).to_json %>)"><%= _("Recalculate odds") %></a>
  </span><br/>
<% end %>
  <div id="backfill_odds_history_status"></div>
<% if @current_phase && @current_phase.scrape_url.present? %>
  <% scrape_start_message = _("Starting scrape...") %>
  <% scrape_error_message = _("Cant start scrape") %>
<script type="text/javascript">
function start_phase_scrape() {
  <%= remote_function(
          :url => { :controller => :phase,
                    :action => :start_scrape,
                    :id => @current_phase },
          :method => 'POST',
          :with => "'rounds=' + encodeURIComponent($('#scrape_rounds').val())",
          :failure => "alert('#{scrape_error_message}')",
          :before => "$('#scrape_status').html('#{scrape_start_message}')") %>
}
</script>
  <br/>
  <label for="scrape_rounds"><%= _("Scrape rounds") %>:</label><br/>
  <input type="text" id="scrape_rounds" size="14" placeholder="<%= _("e.g. 1, 2, 3") %>" />
  <button type="button" onclick="start_phase_scrape()"><%= _("Scrape") %></button>
  <div id="scrape_status"></div>
<% end %>
<%= link_to _("Clone phase to new championship"),
            { :action => :clone_phase, :id => @championship, :phase => @current_phase },
            :method => :post,
            :data => { :confirm => _("Create a new championship with only a copy of this phase?") } %><br/>
<br/>
<% end %>
