/* Compact odds include reserved digit slots; align their percent suffix with
   ordinary percentages in the team graph legend. */
.odds-graph-legend-item td:last-child
{
  text-align: right;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

/* Tooltips flow as text; only table cells need reserved integer slots. */
#odds_tooltip .odds-compact-number,
#odds_selection .odds-compact-number,
[id^="odds_history_tooltip_"] .odds-compact-number
{
  width: auto;
  padding: 0;
}
#odds_tooltip .odds-compact-integer,
#odds_selection .odds-compact-integer,
[id^="odds_history_tooltip_"] .odds-compact-integer
{
  flex: 0 0 auto;
}

.odds-zero { white-space: nowrap; }
.odds-zero-marker { font-size: 0.75em; vertical-align: super; line-height: 0; }

/* Keep the superscript inside its row, anchored to the unused digit slot. */
.odds-zero.odds-compact-number .odds-compact-slot:last-child {
  position: relative;
}
.odds-zero.odds-compact-number .odds-zero-marker {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  line-height: 1;
  vertical-align: baseline;
}
