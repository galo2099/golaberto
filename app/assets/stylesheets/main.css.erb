/**************** CLASSIFICACAO : Begin ************/
.team_table
{
  font-size: 11px;
  width: 100%;
}

.team_table h3 {
  background-color: #330;
  color: #e3efca;
  font-size: 12px;
  font-weight: bold;
  margin-bottom: 1px;
  width: 100%;
  padding-top: 3px;
  padding-bottom: 3px;
}

.team_table h3 span {
  padding-left: 4px;
}

.table_head
{
   color: white;
   background-color: darkblue;
}
.table_line
{
   background-color: lightgray;
}
.class_table
{
  table-layout: fixed;
  width: 100%;
}
.class_table .pos
{
  text-align: left;
}
.class_table .name
{
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: left;
  width: 45%;
}
span.game_odds {
  font-size: small;
  vertical-align: bottom;
}
.class_table .odds
{
  text-align: right;
  width: 12%;
}
.class_table .odds-value
{
  text-align: center;
}
.odds-compact-number
{
  display: inline-flex;
  width: 5.5ch;
  padding: 0.125em 0;
  align-items: center;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}
.odds-compact-integer
{
  flex: 0 0 3ch;
  text-align: right;
}
.odds-compact-dot
{
  flex: 0 0 0.5ch;
  text-align: center;
  line-height: 1;
}
.odds-compact-fraction
{
  display: inline-flex;
  flex: 0 0 2ch;
  min-width: 0;
  align-items: center;
}
.odds-compact-slot
{
  display: inline-flex;
  flex: 0 0 1ch;
  height: 1em;
  line-height: 1;
  min-width: 0;
  justify-content: center;
}
.odds-compact-count
{
  display: inline-block;
  position: relative;
  width: 1ch;
  height: 1em;
  white-space: nowrap;
  /* Include the preceding half-digit decimal slot in the count alignment. */
  --odds-marker-center: 25%;
}
.odds-compact-count-digit
{
  position: absolute;
  top: 0;
  left: var(--odds-marker-center);
  transform: translateX(-50%) scale(0.75);
  transform-origin: center top;
  font-size: 1em;
  font-weight: normal;
  line-height: 1;
}
.odds-compact-count-two-digits
{
  /* Scaling avoids browser minimum-font-size enlarging this two-digit label. */
  font-size: 1em;
  top: 0.08em;
  transform: translateX(-50%) scale(0.6);
}
.odds-compact-count-dots
{
  position: absolute;
  bottom: 0;
  left: 0;
  font-size: 1em;
  font-weight: inherit;
  line-height: 1;
}
.odds-compact-fallback
{
  white-space: nowrap;
  font-size: 0.85em;
}
.odds-compact-legend
{
  font-size: 0.75em;
  margin: 0.2em 0 0.5em;
}
.class_table th
{
  text-align: center;
}
.class_table td
{
  text-align: center;
}
.class_table .odds_spacing
{
  background-color: #e3efca;
  width: 1px;
}
.class_table a:link, a:visited
{
  color: black;
}
.table_line_even
{
  background-color: #CEE3A3;
}
.table_line_odd
{
  background-color: #E3EFCA;
}
/**************** CLASSIFICACAO : END ************/

